# REQUIRED: MongoDB connection string (Atlas or local)
MONGODB_URI=

# OPTIONAL (defaults shown)
PORT=5000
FRONTEND_URL=http://localhost:3000

# REQUIRED to moderate reviews. Use a long random string (32+ characters).
# If empty, the admin moderation endpoints are switched OFF.
ADMIN_API_KEY=

# OPTIONAL: email notifications to you (all four must be set to turn it on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who receives the notifications (your inbox)
ADMIN_NOTIFY_EMAIL=
# Optional sender shown in the email. Defaults to SMTP_USER.
MAIL_FROM=
